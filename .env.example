# Copy to .env for local testing (.env is git-ignored). Never commit real values.
MCP_AUTH_TOKEN=a-long-random-string
PORT=8080

# Option A: service account (key JSON, raw or base64), or a path to the key file
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\path\outside\repo\key.json

# Option B: OAuth client + refresh token (ignored if a service account key is set)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
